# Database
DATABASE_URL=postgresql://autodraft:autodraft_pass@localhost:5432/autodraft

# Redis / Queue
REDIS_URL=redis://localhost:6379

# Object Storage (Minio / S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=autodraft
S3_SECRET_KEY=autodraft_pass
S3_BUCKET=autodraft-assets

# JWT
JWT_SECRET=change_this_to_a_random_string_in_production
JWT_EXPIRES_IN=7d

# OpenAI (Scene Breakdown)
OPENAI_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Replicate / SDXL Character Image Generation
REPLICATE_TOKEN=r8_...
REPLICATE_MODEL=stability-ai/sdxl
gligen
# SDXL for character generation (face lock / InstantID)
SDXL_MODEL=instantx/sdxl-instantid
# or: SG161222/RealVisXL_V4.0

# ElevenLabs TTS
ELEVENLABS_KEY=elevenlabs_...
ELEVENLABS_VOICE_ID=...

# Stripe
STRIPE_SECRET=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

# App
PORT=4000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000

# AI Worker webhook
AI_WEBHOOK_URL=http://localhost:4000/webhooks/ai
RENDER_WEBHOOK_URL=http://localhost:4000/webhooks/render

# Feature flags
ENABLE_FREE_GENERATION=true
FREE_DAILY_LIMIT=5
FREE_WATERMARK=true
