# Production .env template
# Copy this to .env and fill in real values

# Database
DATABASE_URL=postgresql://autodraft:autodraft_pass@db:5432/autodraft

# Redis
REDIS_URL=redis://redis:6379

# Object Storage (Minio internal, or Cloudflare R2 for production)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=autodraft-assets

# JWT
JWT_SECRET=change_this_to_random_32_char_string
JWT_EXPIRES_IN=7d

# Frontend URL (your domain)
FRONTEND_URL=https://yourdomain.com
API_URL=http://backend:4000

# AI Webhooks
AI_WEBHOOK_URL=http://backend:4000/webhooks/ai
RENDER_WEBHOOK_URL=http://backend:4000/webhooks/render

# OpenAI
OPENAI_KEY=sk-your_real_openai_key
OPENAI_MODEL=gpt-4o-mini

# Replicate
REPLICATE_TOKEN=r8-your_real_replicate_token
REPLICATE_MODEL=stability-ai/sdxl

# ElevenLabs
ELEVENLABS_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Stripe (optional for billing)
STRIPE_SECRET=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

# Feature flags
ENABLE_FREE_GENERATION=true
FREE_DAILY_LIMIT=5
FREE_WATERMARK=true
